# Copia para .env e preenche com a configuração da tua app web no Firebase
# (Consola Firebase > Definições do projeto > As tuas apps > Configuração do SDK).
# Se deixares vazio, a app corre em "modo local": guarda só neste browser, sem login nem partilha.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
