# A app já vem ligada ao projeto Firebase "ferias-b-i" (ver src/lib/firebase.js).
# Só precisas deste ficheiro (copiado para .env) para usar outro projeto ou o modo local.

# Modo local: guarda tudo no browser, sem login nem partilha (para experimentar).
# VITE_LOCAL_MODE=true

# Outro projeto Firebase:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
